# Nome da empresa e do SDR, usados no cabeçalho do relatório.
COMPANY_NAME=PRONIX
SDR_NAME=Cauã Lima

# Senha do painel de acessos (/admin), onde você cria as chaves da equipe.
ADMIN_PASSWORD=troque-esta-senha

# Porta do servidor local (a extensão fala com http://localhost:PORT).
PORT=3000

# Provedor da LLM que gera o relatório: anthropic | ollama
LLM_PROVIDER=anthropic

# --- Anthropic (padrão) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Usados só quando o pedido manda "qualidade": "eco" ou "premium" explicitamente
# (nunca automático — "standard"/ANTHROPIC_MODEL continua o comportamento padrão).
ANTHROPIC_MODEL_ECO=claude-haiku-4-5
ANTHROPIC_MODEL_PREMIUM=claude-opus-4-8

# --- Ollama (alternativa local, custo zero) ---
OLLAMA_MODEL=llama3.1
OLLAMA_URL=http://localhost:11434

# --- Limites de custo/confiabilidade (todos têm default seguro no código;
#     só precisa preencher se quiser um valor diferente) ---
# Teto de caracteres da conversa antes do prompt (corta preservando as mensagens
# mais recentes + qualquer trecho com sinal comercial — nunca corta às cegas).
MAX_CONVERSATION_CHARS=24000
# Teto de caracteres de UMA transcrição de áudio (aplicado em /api/transcrever).
MAX_AUDIO_TRANSCRIPTION_CHARS=6000
# Teto de tokens de saída pedido à Anthropic (max_tokens da chamada).
MAX_REPORT_OUTPUT_TOKENS=4000
# Tempo máximo de cada chamada externa (a Vercel corta a função em 60s).
ANTHROPIC_TIMEOUT_MS=50000
GROQ_TIMEOUT_MS=50000
# Teto do áudio enviado para transcrição e validade do cache de transcrição
# (mesmo áudio = mesma transcrição; 0 desliga o cache).
MAX_AUDIO_BYTES=20971520
TRANSCRIPTION_CACHE_TTL_SEG=86400
# Taxa de câmbio usada só para exibir a estimativa de custo em BRL no dashboard
# (fixa/manual — nunca busca cotação numa API externa a cada estimativa).
USD_BRL_RATE=5.3

# --- Ficha do lead (RD Station CRM) no WhatsApp Web ---
# Token do RD Station CRM: no CRM, Configurações → Integrações → Tokens de Acesso.
# Use o token de um usuário que VÊ todas as negociações (senão a ficha de leads de outros
# vendedores não aparece). Fica só no servidor — nunca vai para a extensão.
# Vazio = a ficha fica desligada (a extensão não mostra nada).
RDSTATION_CRM_TOKEN=
# Cache da ficha (s) e tempo máximo de cada consulta ao RD (ms).
CRM_CACHE_TTL_SEG=300
CRM_TIMEOUT_MS=8000

# --- Transcrição ---
# Com GROQ_API_KEY preenchida, transcreve pela API do Groq (é o caminho na Vercel,
# onde não roda Python). Sem ela, usa o faster-whisper local.
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo
# Modelo com visão do Groq: lê o print da conversa e devolve o texto (mesmo
# plano gratuito do Whisper — ler imagem não entra no custo por report).
GROQ_VISION_MODEL=qwen/qwen3.6-27b
# Teto do print enviado (o dashboard já reduz a imagem antes de mandar).
MAX_IMAGEM_BYTES=4194304

# Transcrição local (npm start sem GROQ_API_KEY): faster-whisper via Python
PYTHON_BIN=python
WHISPER_MODEL_SIZE=small

# --- Dados (acessos e histórico de reports) ---
# Na Vercel o disco não persiste: conecte o Upstash/Vercel KV e a plataforma
# preenche estas duas sozinha. Vazias = grava em data/*.json (local).
KV_REST_API_URL=
KV_REST_API_TOKEN=

