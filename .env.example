# Contatos monitorados (números com DDI+DDD, separados por vírgula).
# Ex.: 5511999998888,5511988887777
WATCHED_CONTACTS=

# Nome da empresa, usado no título do relatório.
COMPANY_NAME=Minha Empresa

# Porta da interface web.
PORT=3000

# Provedor da LLM que gera o relatório: anthropic | ollama
LLM_PROVIDER=anthropic

# --- Anthropic (padrão) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Ollama (alternativa local, custo zero) ---
OLLAMA_MODEL=llama3.1
OLLAMA_URL=http://localhost:11434

# --- Transcrição de áudio (faster-whisper via Python) ---
PYTHON_BIN=python
WHISPER_MODEL_SIZE=small
