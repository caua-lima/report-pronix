# Nome da empresa, usado no título do relatório.
COMPANY_NAME=Minha Empresa

# Porta do servidor local (a extensão fala com http://localhost:PORT).
PORT=3000

# Provedor da LLM que gera o relatório: anthropic | ollama
LLM_PROVIDER=anthropic

# --- Anthropic (padrão) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Ollama (alternativa local, custo zero) ---
OLLAMA_MODEL=llama3.1
OLLAMA_URL=http://localhost:11434

# --- Transcrição na NUVEM (Vercel): API do Groq (Whisper) ---
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3-turbo

# --- Transcrição LOCAL (npm start): faster-whisper via Python ---
PYTHON_BIN=python
WHISPER_MODEL_SIZE=small

# --- Separar EU/LEAD pela voz (resemblyzer). Similaridade acima do limiar = você. ---
# Aumente se estiver marcando o lead como EU; diminua se marcar você como LEAD.
VOICE_THRESHOLD=0.75
