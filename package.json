{
  "name": "report-closer",
  "version": "2.0.0",
  "description": "Extensão do Chrome + servidor local que lê a conversa aberta no WhatsApp Web e gera um relatório de handoff de pré-vendas em .docx.",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "test": "node --test \"tests/*.test.js\"",
    "tunel": "cloudflared tunnel --url http://localhost:3000",
    "empacotar": "powershell -NoProfile -Command \"Compress-Archive -Path extension* -DestinationPath public/PRONIX-extensao.zip -Force\""
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@upstash/redis": "^1.38.0",
    "archiver": "^7.0.1",
    "docx": "^8.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pdfkit": "^0.19.1"
  }
}
